VAGRANTFILE_API_VERSION = "2"

# Node definitions – easy to add/remove nodes
# Host: 22 logical CPUs / 32 GB RAM — reserve 7 CPUs + 12 GB for Windows + WSL
# Total VMs: 15 CPUs / 20 GB RAM
NODES = [
  { name: "k8s-master",  ip: "192.168.56.10", memory: 4096,  cpus: 3 },  # control-plane only
  { name: "k8s-worker1", ip: "192.168.56.11", memory: 8192, cpus: 6 },
  { name: "k8s-worker2", ip: "192.168.56.12", memory: 8192, cpus: 6 },
]

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  config.vm.box = "k8s-base"
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = false

  NODES.each do |node_cfg|
    config.vm.define node_cfg[:name] do |node|
      node.vm.hostname = node_cfg[:name]
      # auto_config: false — prevents Vagrant from calling
      # `systemctl restart systemd-networkd` which times out on Ubuntu 24.04
      # with VirtualBox+Hyper-V. The IP is configured by the provisioner below.
      node.vm.network "private_network", ip: node_cfg[:ip], auto_config: false
      node.vm.synced_folder ".", "/vagrant", disabled: true
      node.vm.boot_timeout = 600  # 10 min — needed under VirtualBox+Hyper-V compat mode

      node.vm.provider :virtualbox do |v|
        v.name         = node_cfg[:name]
        v.memory       = node_cfg[:memory]
        v.cpus         = node_cfg[:cpus]
        v.linked_clone = true
        v.customize ["modifyvm", :id, "--paravirtprovider", "hyperv"]
        v.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
      end

      # Configure static IP on the VirtualBox host-only adapter (always enp0s8
      # on Ubuntu Noble with VirtualBox adapter 2).
      node.vm.provision "shell", name: "hostonly-ip", inline: <<~SHELL
        set -e
        tee /etc/netplan/99-vagrant-hostonly.yaml > /dev/null << 'NETPLAN'
        network:
          version: 2
          renderer: networkd
          ethernets:
            enp0s8:
              addresses: ["#{node_cfg[:ip]}/24"]
        NETPLAN
        chmod 600 /etc/netplan/99-vagrant-hostonly.yaml
        netplan apply
      SHELL
    end
  end
end
